{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Edheltur/ha-brewery/master/custom_components/brewery/schemas/brew.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "recipe_revision": {
      "type": "integer",
      "minimum": 1
    },
    "process_version": {
      "type": "string",
      "minLength": 1
    },
    "journal": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/transition"
          },
          {
            "$ref": "#/$defs/sparge_water_added"
          },
          {
            "$ref": "#/$defs/boil_start_volume"
          },
          {
            "$ref": "#/$defs/boil_end_volume"
          },
          {
            "$ref": "#/$defs/density_sample"
          },
          {
            "$ref": "#/$defs/ph_sample"
          },
          {
            "$ref": "#/$defs/transfer"
          },
          {
            "$ref": "#/$defs/hop_added"
          },
          {
            "$ref": "#/$defs/malt_added"
          },
          {
            "$ref": "#/$defs/salt_added"
          },
          {
            "$ref": "#/$defs/acid_added"
          },
          {
            "$ref": "#/$defs/note"
          }
        ]
      },
      "description": "Порядок принятия записей. У перехода stage — исходный этап. Фактическое время определяет порядок показа."
    }
  },
  "required": [
    "schema_version",
    "id",
    "recipe_id",
    "recipe_revision",
    "process_version",
    "journal"
  ],
  "additionalProperties": false,
  "$defs": {
    "transition": {
      "type": "object",
      "properties": {
        "type": {
          "const": "transition"
        },
        "to": {
          "$ref": "name.schema.json"
        }
      },
      "required": [
        "type",
        "to"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        }
      ],
      "unevaluatedProperties": false
    },
    "sparge_water_added": {
      "type": "object",
      "properties": {
        "type": {
          "const": "sparge_water_added"
        },
        "volume": {
          "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/VolumeType",
          "properties": {
            "value": {
              "exclusiveMinimum": 0
            }
          }
        }
      },
      "required": [
        "type",
        "volume"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        }
      ],
      "unevaluatedProperties": false
    },
    "boil_start_volume": {
      "type": "object",
      "properties": {
        "type": {
          "const": "boil_start_volume"
        },
        "volume": {
          "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/VolumeType",
          "properties": {
            "value": {
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "type",
        "volume"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        }
      ],
      "unevaluatedProperties": false
    },
    "boil_end_volume": {
      "type": "object",
      "properties": {
        "type": {
          "const": "boil_end_volume"
        },
        "volume": {
          "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/VolumeType",
          "properties": {
            "value": {
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "type",
        "volume"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        }
      ],
      "unevaluatedProperties": false
    },
    "density_sample": {
      "type": "object",
      "properties": {
        "type": {
          "const": "density_sample"
        },
        "density": {
          "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/GravityType"
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/TemperatureType"
        }
      },
      "required": [
        "type",
        "density",
        "instrument",
        "temperature"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        }
      ],
      "unevaluatedProperties": false
    },
    "ph_sample": {
      "type": "object",
      "properties": {
        "type": {
          "const": "ph_sample"
        },
        "ph": {
          "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/AcidityType"
        }
      },
      "required": [
        "type",
        "ph"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        }
      ],
      "unevaluatedProperties": false
    },
    "transfer": {
      "type": "object",
      "properties": {
        "type": {
          "const": "transfer"
        },
        "fermenter_id": {
          "type": "string",
          "minLength": 1
        },
        "volume": {
          "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/VolumeType",
          "properties": {
            "value": {
              "exclusiveMinimum": 0
            }
          }
        },
        "fermentation_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "fermenter_id",
        "volume"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        }
      ],
      "unevaluatedProperties": false
    },
    "hop_added": {
      "type": "object",
      "properties": {
        "type": {
          "const": "hop_added"
        },
        "ingredient": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/MassType",
          "properties": {
            "value": {
              "exclusiveMinimum": 0
            }
          }
        },
        "recipe_item_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "ingredient",
        "amount"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        }
      ],
      "unevaluatedProperties": false
    },
    "malt_added": {
      "type": "object",
      "properties": {
        "type": {
          "const": "malt_added"
        },
        "ingredient": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/MassType",
          "properties": {
            "value": {
              "exclusiveMinimum": 0
            }
          }
        },
        "recipe_item_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "ingredient",
        "amount"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        }
      ],
      "unevaluatedProperties": false
    },
    "salt_added": {
      "type": "object",
      "properties": {
        "type": {
          "const": "salt_added"
        },
        "ingredient": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/MassType",
          "properties": {
            "value": {
              "exclusiveMinimum": 0
            }
          }
        },
        "recipe_item_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "ingredient",
        "amount"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        }
      ],
      "unevaluatedProperties": false
    },
    "acid_added": {
      "type": "object",
      "properties": {
        "type": {
          "const": "acid_added"
        },
        "ingredient": {
          "enum": [
            "lactic_acid_80_percent",
            "citric_acid"
          ]
        },
        "amount": {
          "oneOf": [
            {
              "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/MassType",
              "properties": {
                "value": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "$ref": "https://raw.githubusercontent.com/beerjson/beerjson/main/json/measureable_units.json#/$defs/VolumeType",
              "properties": {
                "value": {
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        },
        "recipe_item_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "ingredient",
        "amount"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        },
        {
          "if": {
            "properties": {
              "ingredient": {
                "const": "citric_acid"
              }
            }
          },
          "then": {
            "properties": {
              "amount": {
                "properties": {
                  "unit": {
                    "const": "mg"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "amount": {
                "properties": {
                  "unit": {
                    "const": "ml"
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "journal_entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "$ref": "name.schema.json"
        },
        "occurred_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Свободный комментарий пивовара к записи."
        }
      },
      "required": [
        "id",
        "stage",
        "occurred_at"
      ]
    },
    "note": {
      "type": "object",
      "properties": {
        "type": {
          "const": "note"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/journal_entry"
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
