{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Edheltur/ha-brewery/master/custom_components/brewery/schemas/units.schema.json",
  "title": "Brewery measurement units",
  "$defs": {
    "mass": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "mg",
            "g",
            "kg",
            "oz",
            "lb"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "volume": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "ml",
            "l"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "temperature": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "C",
            "F"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "gravity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "brix"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "acidity": {
      "description": "An acidity, as a magnitude and its unit.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "pH"
        },
        "value": {
          "description": "The magnitude of the measurement. Its unit is given by the sibling unit property.",
          "type": "number"
        }
      },
      "required": [
        "unit",
        "value"
      ]
    }
  }
}
