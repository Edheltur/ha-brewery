{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Edheltur/ha-brewery/master/custom_components/brewery/schemas/water_profiles.schema.json",
  "type": "object",
  "properties": {
    "bjcp_edition": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "name.schema.json"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "bjpc_styles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "ions_mg_per_l": {
            "$ref": "ions.schema.json",
            "description": "Цели в мг/л. Пропуск снимает цель, ноль задаёт нулевую цель."
          }
        },
        "required": [
          "name",
          "title",
          "source_url",
          "bjpc_styles",
          "ions_mg_per_l"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "bjcp_edition",
    "profiles"
  ],
  "additionalProperties": false
}
